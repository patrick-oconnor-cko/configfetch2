      {
        "name": "pricing_start_date",
        "datatype": "string",
        "display_style": "textField",
        "label": "Pricing start date",
        "description": "Format YYYY-MM-DD\nOnly fill this if automated pricing should start at a future date (for example free trial period)",
        "reg_exp": "\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])",
        "conditional_read_only": {
          "conditions": [
            {
              "name": "nt_state",
              "operator": "!=",
              "value": true
            }
          ]
        }
      },
      {
        "name": "provisioning_state",
        "datatype": "enum",
        "display_style": "segmentedControl",
        "value": "active",
        "label": "Network Tokens provisioning enabled",
        "required": true,
        "description": "Whether provisioning of new NTs is enabled (does not affect usage of existing NTs)",
        "options": [
          {
            "label": "Yes",
            "value": "active"
          },
          {
            "label": "No",
            "value": "inactive"
          }
        ]
      },
      {
        "name": "default_provision_mode",
        "datatype": "enum",
        "display_style": "segmentedControl",
        "value": "sync",
        "label": "Default provisioning mode",
        "required": true,
        "description": "Asynchronous - no latency with background provisioning, Synchronous - adds latency for higher NT availability for new cards",
        "options": [
          {
            "label": "Asynchronous",
            "value": "async"
          },
          {
            "label": "Synchronous",
            "value": "sync"
          }
        ]
      },

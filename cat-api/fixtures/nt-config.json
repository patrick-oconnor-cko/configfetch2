              "label": "Trade name",
              "required": true
            },
            {
              "name": "scheme_configuration.legal_name",
              "datatype": "string",
              "display_style": "textField",
              "value": "PTOC Sandbox",
              "label": "Legal name",
              "required": true
            },
            {
              "name": "scheme_configuration.primary_url",
              "datatype": "string",
              "display_style": "textField",
              "default_value": "",
              "label": "Webpage URL",
              "required": true,
              "description": "URL with prefix http(s)://",
              "reg_exp": "^(http|https)://.+"
            }
          ]
        }
      },
      {
        "form_section": {
          "label": "Merchant Address",
          "default_state": "collapsed",
